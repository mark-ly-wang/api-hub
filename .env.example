# Database connection (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/apihub?schema=public"

# NextAuth configuration
NEXTAUTH_SECRET="your-super-secret-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Sentry 错误监控和性能追踪
# 注册: https://sentry.io
# 获取 DSN: Sentry Dashboard -> Settings -> Projects -> [Your Project] -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Sentry Source Maps 上传 (构建时使用)
# 生成 Auth Token: Sentry Dashboard -> Settings -> Auth Tokens -> Create New Token
# 权限: project:releases, project:write
SENTRY_AUTH_TOKEN="your-sentry-auth-token-here"
SENTRY_ORG="your-sentry-organization-slug"
SENTRY_PROJECT="api-hub"

# 日志级别 (可选)
# 值: debug, info, warn, error
LOG_LEVEL="info"
