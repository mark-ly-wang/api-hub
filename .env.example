# Database connection (Prisma + Supabase)
# Supabase Project Settings -> Database -> Connection string
# DATABASE_URL: 使用 Connection Pooling (Session mode, 端口 6543)
# DIRECT_URL: 使用 Direct connection (端口 5432, 仅用于 Prisma Migrate)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 本地开发也可以使用 localhost
# DATABASE_URL="postgresql://user:password@localhost:5432/apihub?schema=public"
# DIRECT_URL="postgresql://user:password@localhost:5432/apihub?schema=public"

# NextAuth configuration
NEXTAUTH_SECRET="your-super-secret-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Sentry 错误监控和性能追踪
# 注册: https://sentry.io
# 获取 DSN: Sentry Dashboard -> Settings -> Projects -> [Your Project] -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Sentry Source Maps 上传 (构建时使用)
# 生成 Auth Token: Sentry Dashboard -> Settings -> Auth Tokens -> Create New Token
# 权限: project:releases, project:write
SENTRY_AUTH_TOKEN="your-sentry-auth-token-here"
SENTRY_ORG="your-sentry-organization-slug"
SENTRY_PROJECT="api-hub"

# 日志级别 (可选)
# 值: debug, info, warn, error
LOG_LEVEL="info"

# ============================================
# Kubernetes 部署相关配置
# ============================================

# Pod 标识（自动注入）
# K8S_POD_NAME=${HOSTNAME}
# K8S_NAMESPACE=api-hub

# Prisma 连接池配置（K8s 多副本场景）
# 每个 Pod 的最大数据库连接数（默认 10）
# 计算公式: 总连接数 = Pod数量 × PRISMA_POOL_SIZE
# 示例: 5个Pod × 10连接 = 50个总连接
# 注意: Supabase Free Tier 限制 50 个连接
# PRISMA_POOL_SIZE=10

# 连接超时时间（秒）
# PRISMA_POOL_TIMEOUT=10

# Docker/K8s 健康检查
# HEALTH_CHECK_ENABLED=true
