# ============================================
# Kubernetes Secret 模板
# ============================================
# ⚠️ 重要提示:
# 1. 这是一个模板文件，不要直接提交到 Git
# 2. 实际部署时，使用以下命令创建 Secret:
#    kubectl create secret generic api-hub-secrets \
#      --from-literal=DATABASE_URL='postgresql://...' \
#      --from-literal=DIRECT_URL='postgresql://...' \
#      --from-literal=NEXTAUTH_SECRET='your-secret' \
#      --from-literal=SENTRY_DSN='https://...' \
#      --from-literal=SENTRY_AUTH_TOKEN='your-token' \
#      --from-literal=NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY='your-key' \
#      -n api-hub
# 3. 或者从 .env 文件创建:
#    kubectl create secret generic api-hub-secrets \
#      --from-env-file=.env.production \
#      -n api-hub
# ============================================

apiVersion: v1
kind: Secret
metadata:
  name: api-hub-secrets
  namespace: api-hub
type: Opaque
stringData:
  # 数据库连接字符串（Supabase Pooler）
  # 示例: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
  DATABASE_URL: "postgresql://user:password@host:6543/database?pgbouncer=true"

  # 数据库直连字符串（用于 Prisma Migrate）
  # 示例: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
  DIRECT_URL: "postgresql://user:password@host:5432/database"

  # NextAuth JWT 加密密钥（生成命令: openssl rand -base64 32）
  NEXTAUTH_SECRET: "your-super-secret-32-characters-long-string-here"

  # Sentry DSN（从 Sentry 项目设置中获取）
  SENTRY_DSN: "https://examplePublicKey@o0.ingest.sentry.io/0"

  # Sentry Auth Token（用于上传 Source Maps，从 Sentry 生成）
  SENTRY_AUTH_TOKEN: "your-sentry-auth-token-here"

  # Sentry 组织和项目标识
  SENTRY_ORG: "your-org-slug"
  SENTRY_PROJECT: "api-hub"

  # Supabase 发布密钥（如果使用 Supabase 认证）
  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: "your-supabase-publishable-key"

---
# 如果您想使用 YAML 文件管理 Secret（不推荐，仅用于测试）
# 需要先将值进行 base64 编码:
#   echo -n "your-value" | base64
#
# apiVersion: v1
# kind: Secret
# metadata:
#   name: api-hub-secrets
#   namespace: api-hub
# type: Opaque
# data:
#   DATABASE_URL: <base64-encoded-value>
#   DIRECT_URL: <base64-encoded-value>
#   NEXTAUTH_SECRET: <base64-encoded-value>
#   ...
